SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
JWT_SECRET=your-jwt-secret-key

# Brevo (formerly Sendinblue) Configuration
# Option 1 (Recommended): Brevo REST API (HTTPS port 443 - immune to port blocking)
# Generate your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Brevo SMTP Relay
# View your SMTP credentials at: https://app.brevo.com/settings/keys/smtp
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
BREVO_SMTP_USER=your-brevo-account-email@example.com
BREVO_SMTP_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified Sender Information (Must be verified in Brevo: https://app.brevo.com/senders)
EMAIL_FROM=your-verified-email@example.com
EMAIL_FROM_NAME=SerbisYou MinSU

# Web Push Notification VAPID Credentials
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

